# Vercel environment variables. Create TWO Blob stores: one Public, one Private.
BLOB_PUBLIC_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=
APP_PASSWORD=
ENCRYPTION_SECRET=
WORKER_SECRET=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WORKFLOW_REF=main

# GitHub Actions repository secrets (configure in GitHub, not Vercel):
# COMICFLOW_API_URL=https://your-project.vercel.app
# COMICFLOW_WORKER_SECRET=<same value as Vercel WORKER_SECRET>
# BLOB_PUBLIC_READ_WRITE_TOKEN=<same public Blob token>
